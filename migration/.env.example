# Optional production-only variables. Leave unset for every dry run.
# Never create a service account file inside this project.
MIGRATION_SERVICE_ACCOUNT=
MIGRATION_APPROVE_REAL_PROJECT=

# Optional MySQL overrides: uncomment and provide ALL five, or omit all five
# to parse the existing PHP literal connection settings without executing PHP.
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_PORT=
