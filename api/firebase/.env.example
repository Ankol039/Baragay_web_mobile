# Server process environment; do not expose these variables through VITE_.
# Emulator development is configured automatically by npm run dev:emulators.
BSS_USE_EMULATORS=false
FIREBASE_WEB_API_KEY=
# Short-lived OAuth access token injected/refreshed by the server host.
# Never paste a private key, service account JSON or credential file path here.
FIREBASE_BRIDGE_ACCESS_TOKEN=
