{
  "name": "barangay-survey-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "build:hosting": "vite build --base=/",
    "build:demo": "node scripts/firebase-runtime.mjs --build-only",
    "demo:emulators": "node scripts/firebase-runtime.mjs --build",
    "demo:live": "node scripts/firebase-live.mjs",
    "test:runtime:running": "node tests/firebase-runtime-browser.mjs",
    "test:runtime:unit": "node --test tests/firebase-live-runtime.test.mjs",
    "emulators:start": "firebase emulators:start --config ../firebase.json --only auth,firestore,hosting",
    "test:emulators": "firebase emulators:exec --ui --config ../firebase.json --only auth,firestore,hosting \"node --test --test-concurrency=1 tests/firestore-emulator.test.mjs\"",
    "pretest:emulators": "npm run build:hosting",
    "preemulators:start": "npm run build:hosting",
    "dev:emulators": "node scripts/auth-dev.mjs",
    "test:auth:running": "node tests/firebase-auth-browser.mjs",
    "test:auth:emulators": "firebase emulators:exec --config ../firebase.json --only auth,firestore \"node tests/firebase-auth-browser.mjs\"",
    "test:survey:unit": "node --test tests/validateResponse.test.js",
    "test:survey:running": "node tests/survey-firestore-browser.mjs",
    "test:survey:emulators": "firebase emulators:exec --config ../firebase.json --only auth,firestore \"node tests/survey-firestore-browser.mjs\"",
    "test:rules:running": "node tests/firestore-regression-running.mjs",
    "test:rules": "node tests/firestore-regression-running.mjs",
    "test:reports:running": "node tests/reports-firestore-browser.mjs",
    "test:accounts:running": "node tests/accounts-firestore.mjs",
    "test:profile:running": "node tests/profile-firestore-browser.mjs",
    "test:profile:emulators": "firebase emulators:exec --config ../firebase.json --only auth,firestore \"node tests/profile-firestore-browser.mjs\"",
    "test:staff-survey:running": "node tests/staff-survey-firestore-browser.mjs",
    "test:staff-survey:emulators": "firebase emulators:exec --config ../firebase.json --only auth,firestore \"node tests/staff-survey-firestore-browser.mjs\"",
    "test:accounts:lifecycle:running": "node tests/accounts-lifecycle-firestore.mjs",
    "test:locks:running": "node tests/account-locks-firestore.mjs"
  },
  "dependencies": {
    "chart.js": "4.4.4",
    "firebase": "^13.2.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.5"
  }
}
